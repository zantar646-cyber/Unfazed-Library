# Telegram
BOT_TOKEN=
# Telegram API request timeout in seconds (default 120)
TELEGRAM_REQUEST_TIMEOUT=120
# Optional SOCKS/HTTP proxy for api.telegram.org, e.g. socks5://user:pass@host:1080
TELEGRAM_PROXY=

# Z-Library (for authenticated search/download; optional - leave blank to run anonymous)
ZLIBRARY_EMAIL=
ZLIBRARY_PASSWORD=
# Optional - if set, skips password login entirely
ZLIBRARY_REMIX_USERKEY=
ZLIBRARY_REMIX_USERID=
API_BASE_URL=https://z-library.sk
# Optional comma-separated fallback mirrors, tried when API_BASE_URL is down
# (503/429). Defaults to a built-in list of known Z-Library mirrors.
MIRRORS=

# Anna's Archive (optional - leave blank to run anonymous)
ANNAS_ARCHIVE_BASE_URL=https://annas-archive.org
ANNAS_ARCHIVE_SECRET_KEY=

# Tuning
LOG_LEVEL=INFO
PAGE_SIZE=10
MAX_SEARCH_PAGES=5
RATE_LIMIT_PER_USER=10
RATE_LIMIT_WINDOW=60
DOWNLOAD_TIMEOUT=120
MAX_FILE_SIZE=52428800
# Optional path to persist user language preferences across restarts
# (defaults to light/preferences.json)
PREFERENCES_FILE=
# Optional path to persist user data (favorites, history, settings) across
# restarts (defaults to light/userdata.json)
USERDATA_FILE=

# Support page (optional): configurable payment / contact links
SUPPORT_URL=
CONTACT_URL=

# ==============================================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================================
BOT_TOKEN=your_telegram_bot_token_from_botfather
ADMIN_IDS=123456789,987654321

# ==============================================================================
# SUPABASE / DATABASE CONFIGURATION
# ==============================================================================
# Instructions for Supabase:
# 1. Go to your Supabase project dashboard -> Project Settings -> Database.
# 2. Scroll to "Connection string" -> select "URI" (or "Node.js").
# 3. Choose the "Transaction" pooler (port 6543) - ideal for Vercel Serverless.
#    Replace [YOUR-PASSWORD] with your actual Supabase database password.
# 4. Paste the connection string into DATABASE_URL below.
#
# NOTE: As soon as DATABASE_URL is set, the bot automatically switches to
# PostgreSQL (asyncpg) with serverless NullPool & statement_cache=0 settings.
# Leave it blank or commented to keep using local SQLite.

DATABASE_URL=
# Example Supabase Transaction Pooler:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase API credentials (found in Project Settings -> API)
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Local SQLite Fallback (used when DATABASE_URL is empty) ---
USE_SQLITE=true
DB_NAME=digital_library
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_POOL_MIN=1
DB_POOL_MAX=5

# ==============================================================================
# VERCEL SERVERLESS & WEBHOOK (Required for Vercel deployment, optional locally)
# ==============================================================================
# Set this to your deployed Vercel domain + /api/webhook
# Example: https://your-telegram-bot.vercel.app/api/webhook
WEBHOOK_URL=https://your-bot-name.vercel.app/api/webhook

# Optional secret token (recommended for verifying Telegram webhook authenticity)
# Generate a random string or leave blank
WEBHOOK_SECRET=your_random_secret_token_here

# ==============================================================================
# BOOK SEARCH SOURCES & APIS
# ==============================================================================
# --- Anna's Archive (Primary Source) ---
ANNAS_ARCHIVE_BASE_URL=https://annas-archive.pk
ANNAS_ARCHIVE_SECRET_KEY=your_annas_archive_api_key
ANNAS_ARCHIVE_TIMEOUT=30
ANNAS_ARCHIVE_CACHE_TTL_SEARCH=3600
ANNAS_ARCHIVE_CACHE_TTL_METADATA=86400

# --- Z-Library API & Mirrors ---
API_BASE_URL=https://z-library.ec
API_KEY=
SINGLELOGIN_URL=https://z-library.ec
MIRRORS=https://z-library.ec,https://z-lib.gl

# Z-Library account credentials
ZLIBRARY_EMAIL=your_email@gmail.com
ZLIBRARY_PASSWORD=your_password

# Z-Library remix browser auth tokens (optional alternative to email/password)
ZLIBRARY_REMIX_USERKEY=
ZLIBRARY_REMIX_USERID=

# API Rate Limiting
API_RATE_LIMIT=30
API_RATE_WINDOW=60

# ==============================================================================
# OPTIONAL INTEGRATIONS & LIMITS
# ==============================================================================
# Redis caching (optional - in-memory fallback active if unavailable)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=300

# OpenAI (optional - for AI summaries & intelligent recommendations)
OPENAI_API_KEY=your_openai_api_key

# Google Books API (optional - for fallback cover and description metadata)
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Rate limiting (per Telegram user)
RATE_LIMIT_PER_USER=10
RATE_LIMIT_WINDOW=60

# File download size limits (bytes)
MAX_FILE_SIZE=52428800
DOWNLOAD_BASE_URL=https://downloads.example.com

# Environment & Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

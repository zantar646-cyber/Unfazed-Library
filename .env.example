# Telegram
BOT_TOKEN=your_telegram_bot_token

# Z-Library API
API_BASE_URL=https://your-zlibrary-mirror.com
API_KEY=your_api_key_here

# Z-Library account login (for authenticated requests)
ZLIBRARY_EMAIL=your_email@gmail.com
ZLIBRARY_PASSWORD=your_password

# SingleLogin domain (default: https://z-library.sk)
SINGLELOGIN_URL=https://z-library.sk

# Alternative: provide remix tokens directly (from browser cookies)
# ZLIBRARY_REMIX_USERKEY=your_remix_userkey
# ZLIBRARY_REMIX_USERID=your_remix_userid

# Database (SQLite by default, set USE_SQLITE=false for PostgreSQL)
USE_SQLITE=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_library
DB_USER=postgres
DB_PASSWORD=your_db_password

# Redis caching (optional - bot works without it)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=300

# Admin user IDs (comma separated)
ADMIN_IDS=123456789,987654321

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key

# Google Books API (optional, for fetching book descriptions)
# GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Rate limiting (per user)
RATE_LIMIT_PER_USER=10
RATE_LIMIT_WINDOW=60

# File download limits
MAX_FILE_SIZE=52428800
DOWNLOAD_BASE_URL=https://downloads.example.com

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database connection pool
DB_POOL_MIN=1
DB_POOL_MAX=5

# Z-Library API rate limiting
API_RATE_LIMIT=30
API_RATE_WINDOW=60

# Anna's Archive (primary source)
ANNAS_ARCHIVE_BASE_URL=https://annas-archive.org
ANNAS_ARCHIVE_SECRET_KEY=
ANNAS_ARCHIVE_TIMEOUT=30
ANNAS_ARCHIVE_CACHE_TTL_SEARCH=3600
ANNAS_ARCHIVE_CACHE_TTL_METADATA=86400

# Additional Z-Library mirrors (comma separated) for automatic failover
# Example: MIRRORS=https://z-library.sk,https://1lib.fr
MIRRORS=
